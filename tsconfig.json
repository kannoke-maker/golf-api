{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "CommonJS",
    "moduleResolution": "node",
    "lib":              ["ES2022"],
    "strict":           true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck":     true,
    "outDir":           "dist"
  },
  "include": ["src/**/*.ts"]
}
