# ローカル開発用シークレット
# このファイルを .env としてコピーして実際の値を入力する。
# .env は .gitignore に追加してリポジトリに含めない。
#
# 楽天ウェブサービス登録: https://webservice.rakuten.co.jp/
#
# RAKUTEN_APPLICATION_ID : アプリID（認証必須）
# RAKUTEN_ACCESS_KEY     : アクセスキー（認証必須。affiliateId とは別物）
# RAKUTEN_REFERRER_URL   : 楽天アプリ登録の「APIリクエストを許可するWebサイト」に登録したURL

RAKUTEN_APPLICATION_ID=your_application_id_here
RAKUTEN_ACCESS_KEY=your_access_key_here
RAKUTEN_REFERRER_URL=https://golf-api.your-subdomain.onrender.com
